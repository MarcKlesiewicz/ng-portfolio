{
  "name": "ng-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.22.3",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "ng": "ng",
    "build": "npm run env && ng build",
    "start": "ng serve",
    "env": "node generate-env.js",
    "serve:sw": "npm run build -s && npx http-server ./dist -p 4200",
    "lint": "npm run lint:eslint && npm run lint:styles",
    "lint:eslint": "ng lint",
    "lint:eslint:fix": "ng lint --fix",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:styles:fix": "stylelint \"src/**/*.scss\" --fix",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "translations:extract": "ngx-translate-extract --input ./src --output ./src/translations/template.json --format=json --clean --sort",
    "docs": "hads ./docs -o",
    "compodoc": "compodoc -p tsconfig.json -d docs/generated -s -o",
    "format": "prettier --write \"{*.{json,js,cjs,mjs,ts,html,scss,md,yml,yaml},src/**/*.{ts,js,html,scss,json},docs/**/*.md}\"",
    "format:check": "prettier --check \"{*.{json,js,cjs,mjs,ts,html,scss,md,yml,yaml},src/**/*.{ts,js,html,scss,json},docs/**/*.md}\"",
    "prettier": "npm run format",
    "prettier:check": "npm run format:check",
    "prepare": "husky",
    "generate": "ng generate"
  },
  "dependencies": {
    "@angular/cdk": "22.1.7",
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/localize": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/platform-browser-dynamic": "22.1.7",
    "@angular/router": "22.1.7",
    "@angular/service-worker": "22.1.7",
    "lodash": "^4.17.20",
    "rxjs": "7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "@angular/language-service": "22.1.7",
    "@compodoc/compodoc": "^1.1.11",
    "@ngneat/until-destroy": "^9.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/lodash": "^4.14.184",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.0.8",
    "daisyui": "^5.7.42",
    "eslint": "10.11.0",
    "angular-eslint": "22.5.0",
    "husky": "9.1.7",
    "jsdom": "^30.1.0",
    "material-icons": "^1.13.12",
    "postcss": "^8.4.5",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8",
    "stylelint": "17.15.0",
    "stylelint-config-standard-scss": "17.0.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "*.{ts,js,cjs,mjs,json,html,scss,md,yml,yaml}": "prettier --write --ignore-unknown"
  }
}
