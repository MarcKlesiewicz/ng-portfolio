{
  "name": "ng-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.22.3",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "ng": "ng",
    "generate:books": "node scripts/generate-book-tier-manifest.mjs",
    "prebuild": "npm run generate:books",
    "build": "ng build",
    "prestart": "npm run generate:books",
    "start": "ng serve",
    "preview": "http-server ./dist/browser -p 4200 -c-1 --proxy http://localhost:4200?",
    "serve:sw": "npm run build -s && npm run preview",
    "lint": "npm run lint:eslint && npm run lint:styles",
    "lint:eslint": "ng lint",
    "lint:eslint:fix": "ng lint --fix",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:styles:fix": "stylelint \"src/**/*.scss\" --fix",
    "pretest": "npm run generate:books",
    "test": "ng test --watch=false",
    "pretest:watch": "npm run generate:books",
    "test:watch": "ng test --watch",
    "pretest:coverage": "npm run generate:books",
    "test:coverage": "ng test --watch=false --coverage",
    "format": "prettier --write \"{*.{json,js,cjs,mjs,ts,html,scss,md,yml,yaml},src/**/*.{ts,js,html,scss,json},docs/**/*.md}\"",
    "format:check": "prettier --check \"{*.{json,js,cjs,mjs,ts,html,scss,md,yml,yaml},src/**/*.{ts,js,html,scss,json},docs/**/*.md}\"",
    "prettier": "npm run format",
    "prettier:check": "npm run format:check",
    "prepare": "husky",
    "generate": "ng generate"
  },
  "dependencies": {
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/router": "22.1.7",
    "@angular/service-worker": "22.1.7",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "rxjs": "7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "10.11.0",
    "angular-eslint": "22.5.0",
    "husky": "9.1.7",
    "http-server": "^14.1.1",
    "jsdom": "^30.1.0",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8",
    "stylelint": "17.15.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,js,cjs,mjs,json,html,scss,md,yml,yaml}": "prettier --write --ignore-unknown"
  }
}
